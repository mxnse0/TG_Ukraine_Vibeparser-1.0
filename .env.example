# --- Telegram (обов'язково) ---
# Токен від @BotFather
BOT_TOKEN=123456789:AA...

# Хто має доступ. Порожньо = перший /start стає власником.
# Кілька ID через кому: 111111111,222222222
ADMIN_IDS=

# --- Загальні налаштування ---
TZ=Europe/Kyiv
LOG_LEVEL=INFO
DATA_DIR=./data
DB_PATH=./data/vibeparser.db

# --- Опитування ---
# Інтервал у секундах (20–3600). 60–90 — оптимально.
POLL_INTERVAL=75
HTTP_TIMEOUT=25
MAX_PAGES=2

# --- Сповіщення ---
# card = швидка картка, яку малює Pillow (рекомендовано)
# page = реальний скриншот сторінки через Playwright (потрібен requirements-optional.txt)
SCREENSHOT_MODE=card
STARTUP_MESSAGE=false

# --- Freelancehunt ---
# Потрібен лише для Auto-bid (надсилання відгуку через офіційний API).
# Створи токен: https://freelancehunt.com/my/api
FREELANCEHUNT_TOKEN=

# --- Курси валют до гривні (для фільтра за бюджетом) ---
RATE_USD_UAH=42.0
RATE_EUR_UAH=45.5
RATE_GBP_UAH=53.0
RATE_PLN_UAH=10.5
RATE_CAD_UAH=31.0
RATE_RUB_UAH=0.45
